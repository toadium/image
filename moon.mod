name = "walkzzz/image"

version = "0.6.1"

license = "MIT"

description = "MoonBit image library: pure MoonBit backend for native/wasm-gc/js/wasm multi-target support."

repository = "https://github.com/toadium/image"

keywords = [
  "moonbit",
  "image",
  "png",
  "jpeg",
  "bmp",
  "gif",
  "qoi",
  "resize",
  "hdr",
  "wasm",
  "js",
  "pure",
  "multi-target",
]

preferred_target = "native"

readme = "README.md"

import {
  "walkzzz/core@0.1.0",
  "walkzzz/codec@0.1.0",
  "walkzzz/process@0.1.0",
  "walkzzz/photography@0.1.0",
  "walkzzz/vision@0.1.0",
  "walkzzz/domain@0.1.0",
}
