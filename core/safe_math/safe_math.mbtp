///|
/// 维度安全谓词：宽度在合法范围内
predicate width_safe(w : Int32) {
  (1 <= w) && (w <= 65535)
}

///|
/// 维度安全谓词：高度在合法范围内
predicate height_safe(h : Int32) {
  (1 <= h) && (h <= 65535)
}

///|
/// 通道数安全谓词
predicate channels_safe(c : Int32) {
  (1 <= c) && (c <= 4)
}

///|
/// 安全乘法后置条件谓词
predicate safe_mul_ok(a : Int32, b : Int32, result : Option[Int32]) {
  match result {
    None => (a > 0) && (b > 0) && (a > 2147483647 / b)
    Some(r) =>
      ((a <= 0 || b <= 0) && (r == 0)) ||
      ((a > 0) && (b > 0) && (a <= 2147483647 / b) && (r == a * b))
  }
}

///|
/// 维度合法性谓词
predicate dims_valid(w : Int32, h : Int32, c : Int32) {
  (1 <= w) && (w <= 65535) &&
  (1 <= h) && (h <= 65535) &&
  (1 <= c) &&
  (w <= 2147483647 / h) &&
  (w * h <= 2147483647 / c)
}

///|
/// 通用整数钳制后置条件（简化版：只保证范围）
///
/// clamp_int(v, lo, hi) 的结果在 [lo, hi] 范围内
predicate clamp_int_ok(v : Int32, lo : Int32, hi : Int32, result : Int32) {
  (lo <= result) && (result <= hi)
}

///|
/// 像素值钳制后置条件（简化版：只保证范围）
///
/// clamp_pixel_value(v) 的结果在 [0, 255] 范围内
predicate clamp_pixel_ok(v : Int32, result : Int32) {
  (0 <= result) && (result <= 255)
}

///|
/// 坐标钳制后置条件（简化版：只保证范围）
///
/// clamp_coord(v, max) 的结果在 [0, max-1] 范围内（当 max > 0）
predicate clamp_coord_ok(v : Int32, max_val : Int32, result : Int32) {
  (max_val > 0) && (0 <= result) && (result < max_val)
}

///|
/// 索引合法性谓词
///
/// is_valid_index(i, len) 正确判定 0 <= i < len
predicate valid_index(i : Int32, len : Int32, result : Bool) {
  (result && (0 <= i) && (i < len) && (len > 0)) ||
  (!result && !((0 <= i) && (i < len)))
}

///|
/// 2D 索引合法性谓词
predicate valid_2d_index(x : Int32, y : Int32, w : Int32, h : Int32, result : Bool) {
  (result && (0 <= x) && (x < w) && (0 <= y) && (y < h) && (w > 0) && (h > 0)) ||
  (!result && !((0 <= x) && (x < w) && (0 <= y) && (y < h)))
}

///|
/// 旋转90度幂等性谓词
predicate rotate90_identity(n : Int32, result : Bool) {
  (result && (n % 4 == 0)) ||
  (!result && (n % 4 != 0))
}

///|
/// Paeth 预测函数后置条件
predicate paeth_ok(a : Int32, b : Int32, c : Int32, result : Int32) {
  (result == a) || (result == b) || (result == c)
}

///|
/// QOI 哈希后置条件（简化：结果在 [0, 63]）
predicate qoi_hash_range_ok(result : Int32) {
  (0 <= result) && (result < 64)
}

///|
/// 3-3-2 量化后置条件（简化：结果在 [0, 255]）
predicate quantize_332_range_ok(result : Int32) {
  (0 <= result) && (result <= 255)
}
